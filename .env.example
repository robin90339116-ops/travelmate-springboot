# 示例仅用于进程环境注入，Spring Boot 不自动读取 .env。
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
DASHSCOPE_API_KEY=
AI_PROVIDER=bailian
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_TEXT_MODEL=qwen-plus
AI_VISION_MODEL=qwen-vl-plus
# 切换到豆包(火山引擎方舟,OpenAI 兼容)时整组替换,模型填方舟控制台的模型名或推理接入点 ID(ep-xxx):
# AI_PROVIDER=doubao
# DASHSCOPE_API_KEY=<ARK_API_KEY>
# AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# AI_TEXT_MODEL=<doubao 文本模型或 ep-xxx>
# AI_VISION_MODEL=<doubao 视觉模型或 ep-xxx>
AMAP_WEB_KEY=
ALIYUN_NLS_APP_KEY=
ALIYUN_NLS_ACCESS_TOKEN=
DATASOURCE_URL=jdbc:mysql://localhost:3306/travelmate
DATASOURCE_USER=travelmate
DATASOURCE_PASSWORD=replace-me
REDIS_HOST=localhost
REDIS_PORT=6379
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=travelmate
RABBITMQ_PASSWORD=replace-me
